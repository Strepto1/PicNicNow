# --- Picnic -----------------------------------------------------------------
# Laat leeg om in demo-modus te draaien (met voorbeeld-bestelgeschiedenis).
PICNIC_USERNAME=
PICNIC_PASSWORD=
PICNIC_COUNTRY=NL

# --- Claude (gespreksassistent) ---------------------------------------------
# Zonder sleutel werkt alles behalve het gesprek met de assistent.
ANTHROPIC_API_KEY=
PICNICNOW_MODEL=claude-opus-5-5
# low | medium | high  (medium is snel en goedkoop genoeg voor boodschappen)
PICNICNOW_EFFORT=medium

# --- Huishouden -------------------------------------------------------------
PICNICNOW_NAMES=Kevin,Partner
PICNICNOW_BABY_NAME=Baby
# Geboortedatum baby (JJJJ-MM-DD) – bepaalt de fase van de babyhapjes
PICNICNOW_BABY_BIRTHDATE=
PICNICNOW_PERSONS=2
# 0 = geen voorkeur, 1 = bio als het niet veel duurder is, 2 = altijd bio als het kan
PICNICNOW_ORGANIC=2
# Hoeveel % duurder mag bio maximaal zijn bij voorkeur 1
PICNICNOW_ORGANIC_MAX_PREMIUM=40

# --- Aanbiedingen -----------------------------------------------------------
# Welke winkels vergelijken (ah, vomar, dekamarkt)
PICNICNOW_DEAL_STORES=ah,vomar,dekamarkt
# Alleen producten vanaf deze Picnic-prijs (in euro) vergelijken
PICNICNOW_DEAL_MIN_PRICE=2.50
# Optioneel: DekaMarkt/Dirk app-API (zelf uit de app te halen); anders wordt de website gelezen
DEKAMARKT_API_ID=
DEKAMARKT_API_KEY=
DEKAMARKT_STORE_ID=

# --- Server -----------------------------------------------------------------
PICNICNOW_DB=picnicnow.db
PICNICNOW_HOST=0.0.0.0
PICNICNOW_PORT=8000
# Optionele pincode om de app af te schermen op je thuisnetwerk
PICNICNOW_PIN=
