# --- Picnic -----------------------------------------------------------------
# Laat leeg om in demo-modus te draaien (met voorbeeld-bestelgeschiedenis).
PICNIC_USERNAME=
PICNIC_PASSWORD=
PICNIC_COUNTRY=NL

# --- Assistent ---------------------------------------------------------------
# Zonder sleutel draait de GRATIS commandomodus ("zet melk op de lijst", "woensdag shakshuka", …).
# Met sleutel praat Claude volwaardig mee (betaald per gebruik, zie README → Kosten).
ANTHROPIC_API_KEY=
# claude-opus-5-5 (slimst) | claude-sonnet-5-5 (goedkoper) | claude-haiku-5-5 (bijna gratis)
PICNICNOW_MODEL=claude-opus-5-5
# low | medium | high  (medium is snel en ruim voldoende voor boodschappen)
PICNICNOW_EFFORT=medium
# Maximaal per maand in dollars; daarboven valt de app terug op de gratis modus (0 = geen limiet)
PICNICNOW_MONTHLY_BUDGET_USD=5
# auto = Claude als er een sleutel is · commando = altijd de gratis modus
PICNICNOW_ASSISTANT=auto

# --- Huishouden -------------------------------------------------------------
PICNICNOW_NAMES=Kevin,Partner
PICNICNOW_BABY_NAME=Baby
# Geboortedatum baby (JJJJ-MM-DD) – bepaalt de fase van de babyhapjes
PICNICNOW_BABY_BIRTHDATE=
# …of alleen de leeftijd in maanden (wordt eenmalig omgerekend en groeit daarna mee)
PICNICNOW_BABY_AGE_MONTHS=9
# Eet de baby al mild gekruid mee? (kerrie, knoflook, ui, peper…) 1 = ja
PICNICNOW_BABY_SPICE=1
PICNICNOW_BABY_LIKES=kerrie, peper, knoflook, ui, prei, tomaat, rijst, pasta, mediterraan
# Aardappel-groente-vlees: normaal | af en toe
PICNICNOW_BABY_AVG=af en toe
PICNICNOW_PERSONS=2
# 0 = geen voorkeur, 1 = bio als het niet veel duurder is, 2 = altijd bio als het kan
PICNICNOW_ORGANIC=2
# Hoeveel % duurder mag bio maximaal zijn bij voorkeur 1
PICNICNOW_ORGANIC_MAX_PREMIUM=40

# --- Aanbiedingen -----------------------------------------------------------
# Welke winkels vergelijken (ah, vomar, dekamarkt)
PICNICNOW_DEAL_STORES=ah,vomar,dekamarkt
# Alleen producten vanaf deze Picnic-prijs (in euro) vergelijken
PICNICNOW_DEAL_MIN_PRICE=2.50
# Optioneel: DekaMarkt/Dirk app-API (zelf uit de app te halen); anders wordt de website gelezen
DEKAMARKT_API_ID=
DEKAMARKT_API_KEY=
DEKAMARKT_STORE_ID=

# --- Server -----------------------------------------------------------------
PICNICNOW_DB=picnicnow.db
PICNICNOW_HOST=0.0.0.0
PICNICNOW_PORT=8000
# Optionele pincode om de app af te schermen op je thuisnetwerk
PICNICNOW_PIN=
